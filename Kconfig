mainmenu "Edge AI Hello World"

source "Kconfig.zephyr"

menu "Application options"

config APP_ENABLE_INFERENCE
	bool "Enable camera inference thread"
	default y
	depends on TENSORFLOW_LITE_MICRO
	help
	  Enables TensorFlow Lite Micro inference processing and starts the
	  inference runtime thread. Disable this for camera/display-only runs.

endmenu

menu "WiFi auto-connect"

config WIFI_AUTOCONNECT
	bool "Auto-connect to WiFi on boot"
	default y
	depends on WIFI_ESP_AT
	help
	  Automatically connect to the configured WiFi network at startup.
	  The connection attempt runs in a background thread so it does not
	  block camera, display, or inference.

config WIFI_AUTOCONNECT_SSID
	string "Primary WiFi SSID"
	default ""
	depends on WIFI_AUTOCONNECT
	help
	  SSID of the primary WiFi network to connect to on boot.

config WIFI_AUTOCONNECT_PSK
	string "Primary WiFi passphrase (WPA2-PSK)"
	default ""
	depends on WIFI_AUTOCONNECT
	help
	  WPA2-PSK passphrase for the primary WiFi network.
	  Leave empty for open networks.

config WIFI_AUTOCONNECT_SSID2
	string "Secondary WiFi SSID"
	default ""
	depends on WIFI_AUTOCONNECT
	help
	  SSID of a secondary WiFi network.  If the primary network is
	  not reachable, the auto-connect routine will try this one.
	  Leave empty to disable the secondary network.

config WIFI_AUTOCONNECT_PSK2
	string "Secondary WiFi passphrase (WPA2-PSK)"
	default ""
	depends on WIFI_AUTOCONNECT
	help
	  WPA2-PSK passphrase for the secondary WiFi network.
	  Leave empty for open networks.

config WIFI_AUTOCONNECT_RETRY_TIMEOUT_S
	int "Connection retry timeout (seconds)"
	default 60
	depends on WIFI_AUTOCONNECT
	help
	  How long to keep retrying the WiFi connection before giving up.
	  Set to 0 to try only once.

endmenu

if GOLIOTH_OTA

config GOLIOTH_APP_PSK_ID
	string "Golioth PSK identity (device credentials)"
	default "my-psk-id"
	help
	  Lab-only: copy from Golioth Console device details. Use per-device
	  provisioning for production (not hardcoded secrets).

config GOLIOTH_APP_PSK
	string "Golioth PSK secret"
	default "my-psk"
	help
	  Lab-only: device pre-shared key. Replace with secure storage for production.

config GOLIOTH_FW_UPDATE_PACKAGE_NAME
	string "Golioth firmware package name"
	default "main"
	help
	  Must match the package name in Golioth Console (Firmware Updates).

config GOLIOTH_FW_UPDATE_OBSERVATION_RETRY_MAX_DELAY_S
	int "Maximum delay before retrying OTA manifest observation (seconds)"
	default 300

config GOLIOTH_FW_UPDATE_THREAD_STACK_SIZE
	int "Golioth OTA thread stack size"
	default 4096

config GOLIOTH_FW_UPDATE_ROLLBACK_TIMER_S
	int "FW update rollback timer (seconds) if Golioth unreachable after boot"
	default 300

config GOLIOTH_FW_UPDATE_IDLE_DISCONNECT
	bool "Stop Golioth client when up to date or package missing from manifest"
	default n
	help
	  After a manifest, call golioth_client_stop() when there is nothing useful to do:
	  cohort target version equals APP_VERSION, or the configured package name is absent from
	  the manifest. Reduces Wi-Fi traffic; new deployments are not detected until reboot
	  (or future reconnect logic).

endif # GOLIOTH_OTA
